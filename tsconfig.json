{
  "compilerOptions": {
    "module": "ESNext",
    "rootDir": "packages",
    "outDir": "builds/packages",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "target": "ESNext",
    "declaration": true,
    "declarationMap": false,
    "removeComments": false,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noImplicitThis": false,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "importsNotUsedAsValues": "remove",
    "experimentalDecorators": true,
    "sourceMap": false,
    "lib": ["ESNext"]
  },
  "include": [
    "packages/**/*.ts"
  ],
  "exclude": [
    "builds",
    "node_modules"
  ]
}
