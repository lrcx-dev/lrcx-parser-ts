{
  "name": "lrcx-parser",
  "version": "0.1.1",
  "description": "TypeScript parser and serializer for the LRCX lyric format.",
  "type": "module",
  "private": false,
  "main": "./builds/packages/index.js",
  "types": "./builds/packages/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./builds/packages/index.d.ts",
      "import": "./builds/packages/index.js",
      "default": "./builds/packages/index.js"
    }
  },
  "files": [
    "builds/packages/*.js",
    "builds/packages/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "lrcx",
    "lyrics",
    "parser",
    "serializer",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "loyuri",
    "url": "https://github.com/loyuri"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lrcx-dev/lrcx-parser-ts.git"
  },
  "bugs": {
    "url": "https://github.com/lrcx-dev/lrcx-parser-ts/issues"
  },
  "homepage": "https://github.com/lrcx-dev/lrcx-parser-ts#readme",
  "scripts": {
    "dev": "node ./scripts/dev-preview.mjs",
    "build": "node ./scripts/build-lib.mjs",
    "build:playground": "node ./scripts/build-playground.mjs",
    "build:watch": "node ./scripts/clean-generated.mjs builds/packages && node ./scripts/run-tsc.mjs -p tsconfig.json --watch --preserveWatchOutput",
    "test": "node ./scripts/build-lib.mjs && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  }
}
